{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "matharena",
	"main": "src/index.tsx",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "matharena",
			"database_id": "e3a3ab6f-001b-4acc-801d-d1429cf2c7da"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "5a9f095f649748b188a71be5c9e5749b"
		}
	],
